DATABASE_URL="postgresql://counselor:counselor_dev_password@localhost:5433/school_counselor?schema=public"

NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3010"

STORAGE_DIR="./storage"
PDF_ENGINE="playwright"

# Leave unset to use local-disk storage (STORAGE_DIR) in development.
# Set all four to switch to Cloudflare R2.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# Used only by prisma/seed.ts to hash the initial counselor account password.
SEED_COUNSELOR_EMAIL="email@email.com"
SEED_COUNSELOR_PASSWORD="replace-with-a-real-password"
